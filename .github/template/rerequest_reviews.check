#!/bin/sh -eu
owner="${GITHUB_REPOSITORY%%/*}"
curl -s --fail --retry 16 --header "Authorization: Bearer $GITHUB_TOKEN" "${GITHUB_API_URL:-https://api.github.com}"/repos/"$GITHUB_REPOSITORY"/collaborators'?per_page=100' | jq -e --arg owner "$owner" '[.[] | select((.login | ascii_downcase) != ($owner | ascii_downcase))] | length > 0' > /dev/null
