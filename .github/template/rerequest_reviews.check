#!/bin/sh -eu
# Deploy only to repositories that have at least one collaborator other than the owner.
# Listing collaborators requires push access to the target repository, so prefer GH_TOKEN (bot token) over GITHUB_TOKEN.
owner="${GITHUB_REPOSITORY%%/*}"
collaborators="$(curl -s --fail --retry 16 --header "Authorization: Bearer ${GH_TOKEN:-$GITHUB_TOKEN}" "${GITHUB_API_URL:-https://api.github.com}"/repos/"$GITHUB_REPOSITORY"/collaborators'?per_page=100')"
printf '%s' "$collaborators" | jq -e --arg owner "$owner" '[.[] | select((.login | ascii_downcase) != ($owner | ascii_downcase))] | length > 0' > /dev/null
